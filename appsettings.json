{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EdgeTechDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "EdgeTechSuperSecretKeyMustBe32CharactersLong!",
    "Issuer": "EdgeTechAPI",
    "Audience": "EdgeTechClient",
    "ExpiresMinutes": "60"
  },
  "AzureBlobStorage": {
    "ConnectionString": "YOUR_AZURE_CONNECTION_STRING_HERE",
